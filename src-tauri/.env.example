# Optional dev overrides. Copy to src-tauri/.env (read by the Rust backend at
# startup; never bundled). Placeholders only: never commit real values.
#
# OAuth keys can also be entered in Settings → Platform keys (stored in the OS
# keychain). Environment values take precedence over Settings.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional: also settable from Settings (stored in the OS keychain).
ANTHROPIC_API_KEY=
# Optional: use a specific FFmpeg instead of the bundled one.
FFMPEG_PATH=
FFPROBE_PATH=
