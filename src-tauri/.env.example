# Copy to src-tauri/.env (read by the Rust backend at startup; never bundled).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional: also settable from Settings (stored in the OS keychain).
ANTHROPIC_API_KEY=
# Optional: override binary locations.
FFMPEG_PATH=
FFPROBE_PATH=
